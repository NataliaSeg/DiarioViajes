{
  "expo": {
    "name": "DiarioViajes",
    "slug": "DiarioViajes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.natalia.diarioviajes"
    },
    "android": {
      "package": "com.natalia.diarioviajes",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "DiarioViajes necesita la cámara para tomar fotos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DiarioViajes utiliza tu ubicación para guardar cada viaje."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "05740f6a-47f2-43f1-a794-1ce340958db9"
      }
    }
  }
}
